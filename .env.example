# ============================================================
# QR POS & KDS SaaS - Environment Variables
# ============================================================
# INSTRUCTIONS:
# 1. Copy this file to .env and .env.local
# 2. Fill in all values - the app will REFUSE to start without them
# 3. NEVER commit .env files to version control
# ============================================================

# ── Database ──────────────────────────────────────────────────
# PostgreSQL connection string. Use SSL in production.
DATABASE_URL="postgresql://user:password@localhost:5432/qr_pos_kds?schema=public"

# ── NextAuth.js ───────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="generate-a-64-char-random-secret-here"
# The canonical URL of your deployment
NEXTAUTH_URL="http://localhost:3000"

# ── Razorpay (server-side only - NEVER prefix with NEXT_PUBLIC_) ──
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"
RAZORPAY_WEBHOOK_SECRET="your-razorpay-webhook-secret"

# ── Razorpay (client-side - only the key ID is safe to expose) ──
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"

# ── WebSocket Server ──────────────────────────────────────────
WS_PORT="4000"
NEXT_PUBLIC_WS_URL="http://localhost:4000"

# ── Application ───────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Comma-separated list of allowed CORS origins
CORS_ORIGINS="http://localhost:3000"

# ── Rate Limiting ─────────────────────────────────────────────
# Set to "redis" in production, "memory" for development
RATE_LIMIT_STORE="memory"

# ── Security ──────────────────────────────────────────────────
# Set to "true" in production to enforce HTTPS cookies
SECURE_COOKIES="false"
# Session expiry in seconds (default: 24 hours)
SESSION_MAX_AGE="86400"
