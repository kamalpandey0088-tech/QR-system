# ==============================================================================
# TEST ENVIRONMENT VARIABLES
# ==============================================================================
# WARNING: NEVER run integration tests against the production database!
# Create a dedicated "qr-system-test" Supabase project for automated testing.
# ==============================================================================

# ── Database (Test Database) ──
DATABASE_URL="postgresql://postgres.[YOUR-TEST-PROJECT]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[YOUR-TEST-PROJECT]:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# ── Payment Providers (Test Keys Only) ──
RAZORPAY_KEY_ID="rzp_test_YOUR_TEST_KEY"
RAZORPAY_KEY_SECRET="YOUR_TEST_SECRET"
RAZORPAY_WEBHOOK_SECRET="test_webhook_secret"
